  "part1_volatility_risk_contribution": {
    "framework": "Differentiable Covariance-Aware Marginal Volatility Decomposition (Euler Homogeneous Function)",
    "mathematical_formulation": {
      "portfolio_variance": "sigma_p^2 = w' Sigma w",
      "portfolio_volatility": "sigma_p = sqrt(w' Sigma w)",
      "marginal_risk_contribution": "MRC_i = d(sigma_p)/d(w_i) = (Sigma w)_i / sigma_p",
      "absolute_risk_contribution": "RC_i = w_i * MRC_i = w_i * (Sigma w)_i / sigma_p",
      "percentage_risk_contribution": "PRC_i = RC_i / sigma_p = w_i * (Sigma w)_i / sigma_p^2",
      "euler_theorem_invariant": "sum(RC_i) = sigma_p, sum(PRC_i) = 1.0000 (within 1e-12 tolerance)"
    },
